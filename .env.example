# Copy this file to .env and fill in your key(s). Never commit the real .env.

# Which provider agent.py talks to -- "openai" or "openrouter". Same code
# either way; this is the only line you flip to switch.
LLM_PROVIDER=openai

# --- openai (used when LLM_PROVIDER=openai) ------------------------------
OPENAI_API_KEY=sk-...
# Optional -- defaults to gpt-4o-mini if unset
RCA_MODEL=gpt-4o-mini

# --- openrouter (used when LLM_PROVIDER=openrouter) -----------------------
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Pick a current free model from https://openrouter.ai/models?max_price=0
# (free model availability changes over time -- verify before relying on one)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional, sent as OpenRouter's recommended attribution headers
OPENROUTER_SITE_URL=https://github.com
OPENROUTER_APP_NAME=mbcie-rca-agent

# --- FastAPI basic auth (main.py) -----------------------------------------
BASIC_AUTH_USERNAME=reviewer
# If left blank, main.py generates a random one at startup and prints it --
# set a real one here so credentials are stable across restarts.
BASIC_AUTH_PASSWORD=changeme
